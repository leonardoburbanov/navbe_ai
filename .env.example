# Navbe environment variables (copy to .env and fill in locally).
# Never commit real secrets.

# SQLite control-plane database path
# Default: <repo>/navbe.db when in a checkout, else ~/.navbe/navbe.db
NAVBE_DB_PATH=./navbe.db

# Directory for flow definitions
NAVBE_FLOWS_DIR=./navbe_flows

# Local credentials JSON (preferred over putting connector keys only in .env)
# Agents can also manage keys via MCP secret_set / secret_list (values never returned).
NAVBE_CREDENTIALS_PATH=./navbe_credentials.json

# Sync config JSON (optional GitHub workspace mirror)
# NAVBE_SYNC_CONFIG_PATH=./navbe_sync.json

# Managed GitHub App token file (Device Flow — never commit)
# NAVBE_GITHUB_OAUTH_PATH=./navbe_github_oauth.json

# GitHub App client id (Device Flow enabled; public client, no secret)
# Defaults to the official Navbe AI app. Override for forks/self-hosted apps.
# NAVBE_GITHUB_APP_CLIENT_ID=Iv23livr6YIrrz0WNGpN
# NAVBE_GITHUB_APP_SLUG=navbe-ai
# Legacy alias (still read if APP client id empty):
# NAVBE_GITHUB_OAUTH_CLIENT_ID=

# Logging level (DEBUG, INFO, WARNING, ERROR)
NAVBE_LOG_LEVEL=INFO

# FastMCP server name
NAVBE_MCP_SERVER_NAME=navbe

# Optional Anthropic API key — prefer credentials store (not env):
#   navbe secret set NAVBE_ANTHROPIC_API_KEY
# NAVBE_ANTHROPIC_API_KEY=  # ignored by llm_call; kept only for legacy tooling

# --- Connector secrets (navbe_credentials.json ONLY) ---
# Do not put connector API keys here. Use:
#   navbe secret set RESEND_API_KEY --app resend
#   navbe secret set CRM_API_KEY --app crm
# FlowSpec refs: {"$secret": "RESEND_API_KEY"}
# Resend connector example:
#   "type": "resend", "config": {"api_key": {"$secret": "RESEND_API_KEY"}}
# GitHub sync auth is GitHub App Device Flow (navbe login github), not GITHUB_TOKEN.
