# Navbe environment variables (copy to .env and fill in locally).
# Never commit real secrets.

# SQLite control-plane database path
# Default: <repo>/navbe.db when in a checkout, else ~/.navbe/navbe.db
NAVBE_DB_PATH=./navbe.db

# Directory for flow definitions
NAVBE_FLOWS_DIR=./navbe_flows

# Local credentials JSON (preferred over putting connector keys only in .env)
# Agents can also manage keys via MCP secret_set / secret_list (values never returned).
NAVBE_CREDENTIALS_PATH=./navbe_credentials.json

# Sync config JSON (optional GitHub flows mirror)
# NAVBE_SYNC_CONFIG_PATH=./navbe_sync.json

# Logging level (DEBUG, INFO, WARNING, ERROR)
NAVBE_LOG_LEVEL=INFO

# FastMCP server name
NAVBE_MCP_SERVER_NAME=navbe

# Optional Anthropic API key (leave empty if unused)
NAVBE_ANTHROPIC_API_KEY=

# --- Connector secret refs ---
# Connector configs may reference secrets via {"$secret": "KEY_NAME"}.
# Resolution order: navbe_credentials.json first, then process env / .env.
# Prefer: MCP secret_set or edit NAVBE_CREDENTIALS_PATH JSON.
# Fallback: define the env var here (no quotes needed for typical values):
# SALES_BOT_KEY=sk-replace-me
# RESEND_API_KEY=re-replace-me
# GITHUB_TOKEN=ghp-replace-me
