# Navbe runtime config (copy to .env and adjust paths locally).
# Never commit real secrets.
#
# API keys (Resend, Anthropic, CRM, …) do NOT go here.
# Store them with:  navbe secret set KEY [--app slug]
# File: navbe_credentials.json (or NAVBE_CREDENTIALS_PATH below).

# SQLite control-plane database path
# Default: <repo>/navbe.db when in a checkout, else ~/.navbe/navbe.db
NAVBE_DB_PATH=./navbe.db

# Directory for flow definitions
NAVBE_FLOWS_DIR=./navbe_flows

# Directory for schedule definitions
NAVBE_SCHEDULES_DIR=./navbe_schedules

# Local credentials JSON (API keys / connector secrets)
NAVBE_CREDENTIALS_PATH=./navbe_credentials.json

# Sync config JSON (optional GitHub workspace mirror)
# NAVBE_SYNC_CONFIG_PATH=./navbe_sync.json

# Managed GitHub App token file (Device Flow — never commit)
# NAVBE_GITHUB_OAUTH_PATH=./navbe_github_oauth.json

# GitHub App client id (Device Flow; public client, no secret)
# Defaults to the official Navbe AI app. Override for forks/self-hosted apps.
# NAVBE_GITHUB_APP_CLIENT_ID=Iv23livr6YIrrz0WNGpN
# NAVBE_GITHUB_APP_SLUG=navbe-ai
# Legacy alias (still read if APP client id empty):
# NAVBE_GITHUB_OAUTH_CLIENT_ID=

# Logging level (DEBUG, INFO, WARNING, ERROR)
NAVBE_LOG_LEVEL=INFO

# FastMCP server name
NAVBE_MCP_SERVER_NAME=navbe
