{
  "name": "navbe-desktop",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "ensure-sidecar": "powershell -NoProfile -ExecutionPolicy Bypass -File ../scripts/ensure_sidecar.ps1",
    "sidecar": "powershell -NoProfile -ExecutionPolicy Bypass -File ../scripts/build_sidecar.ps1",
